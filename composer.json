{
    "name": "aranlucas/better-bracket",
    "description": "A modern tournament bracket and group manager.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5.12",
        "codeigniter4/framework": "^4.7.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "phpstan/phpstan": "^2.3.1",
        "phpunit/phpunit": "^13.4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "test/_support/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform-check": true,
        "policy": {
            "abandoned": {
                "audit": "fail",
                "block": true
            }
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@lint",
            "@analyse",
            "@test",
            "@test:browser",
            "@composer validate --strict",
            "@composer audit --locked"
        ],
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit --testdox",
        "lint": "find app public test -type f -name '*.php' -exec php -l {} +",
        "test:browser": "npm run test:js"
    }
}
