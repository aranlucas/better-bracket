{
  "name": "better-bracket",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint public/assets/js test vitest.config.mjs",
    "test:js": "vitest run",
    "dev": "portless run --app-port 8080 php spark serve",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "build": "docker build --tag better-bracket:ci .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.8",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
