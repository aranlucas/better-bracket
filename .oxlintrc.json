{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json"
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    "build/**",
    "dist/**",
    "coverage/**",
    ".snapshot*",
    ".next/**",
    "_site/**"
  ]
}
